# Google Cloud & Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-03-fd05546dff54
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-004

# Application Settings
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./cti_platform.db
VECTOR_DB_PATH=./vector_store.db
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Gmail Notification Settings
GMAIL_CREDENTIALS_FILE=./credentials.json
GMAIL_TOKEN_FILE=./token.json
GMAIL_DEFAULT_RECIPIENT=security-analyst@example.com
GMAIL_ENABLED=false
GMAIL_HIGH_SEVERITY_ONLY=false

# Threat Intelligence Feed Polling
POLLING_INTERVAL_MINUTES=15
AUTO_INVESTIGATE=true
MAX_PARALLEL_INVESTIGATIONS=3
